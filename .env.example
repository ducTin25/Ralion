# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

PYTHONPATH=.

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# OpenRouter (OpenAI-compatible; used by F5 when this key is configured)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# DeepSeek classifier fallback for ambiguous project documents.
DEEPSEEK_API_KEY=
DEEPSEEK_CLASSIFIER_TIMEOUT_SECONDS=20
DEEPSEEK_CLASSIFIER_MAX_CONCURRENCY=4

# Modal BGE-M3 endpoint (set after `modal deploy modal_bge_m3/app.py`)
BGE_M3_ENDPOINT=
BGE_M3_API_KEY=
CHAT_OVERALL_DEADLINE_SECONDS=25
CHAT_EMBEDDING_BUDGET_SECONDS=6
CHAT_LLM_BUDGET_SECONDS=20
CHAT_PERSISTENCE_RESERVE_SECONDS=1
# Keep the pooled connection to Modal alive between chat turns (httpx default is 5s, which
# expires between two questions and forces a fresh TCP+TLS handshake on every request).
CHAT_HTTP_KEEPALIVE_EXPIRY_SECONDS=300
CHAT_EMBEDDING_CONNECT_TIMEOUT_SECONDS=2
CHAT_EMBEDDING_READ_TIMEOUT_SECONDS=3
CHAT_EMBEDDING_MAX_ATTEMPTS=2
CHAT_EMBEDDING_BACKOFF_INITIAL_SECONDS=0.05
CHAT_EMBEDDING_BACKOFF_MULTIPLIER=2
CHAT_EMBEDDING_BACKOFF_MAX_SECONDS=0.2
# Modal scales to zero for cost control, so keep this ping enabled: it's what keeps a
# container warm for every embedding-dependent use case (chat, PM/HR upload, GitHub sync),
# not just chat's own retry budget.
CHAT_EMBEDDING_WARMUP_ENABLED=true
CHAT_EMBEDDING_WARMUP_INTERVAL_SECONDS=240
CHAT_EMBEDDING_WARMUP_TIMEOUT_SECONDS=60
CHAT_LLM_CONNECT_TIMEOUT_SECONDS=2
CHAT_LLM_READ_TIMEOUT_SECONDS=15
CHAT_LLM_MAX_ATTEMPTS=2
CHAT_LLM_BACKOFF_INITIAL_SECONDS=0.1
CHAT_LLM_BACKOFF_MULTIPLIER=2
CHAT_LLM_BACKOFF_MAX_SECONDS=0.5
INGESTION_OVERALL_DEADLINE_SECONDS=600
INGESTION_EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
INGESTION_EMBEDDING_READ_TIMEOUT_SECONDS=120
INGESTION_EMBEDDING_MAX_ATTEMPTS=4
INGESTION_EMBEDDING_BACKOFF_INITIAL_SECONDS=1
INGESTION_EMBEDDING_BACKOFF_MULTIPLIER=3
INGESTION_EMBEDDING_BACKOFF_MAX_SECONDS=9

# ---- GitHub F2 sync ----
# Encrypts each project's connected PAT at rest (project_github_credentials.token_ciphertext).
# Required in production; the dev default only works locally.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_CREDENTIAL_ENCRYPTION_KEY=
# Dev/test-only fallback so a single local repo can sync without connecting a per-project
# credential first (see github_credential_provider.py). Fine-grained PAT, Contents: Read-only,
# never a write-scoped token. PM-facing/production sync always uses a per-project token
# connected via PATCH /knowledge-documents/pm/projects/{id}/github-repo instead.
GITHUB_TOKEN=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/pgonboarding

# ---- Cloudinary object storage ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=pgonboarding

# ---- Auth / Session ----
# Khoá ký cookie phiên. Sinh khoá thật bằng: python -c "import secrets;print(secrets.token_hex(32))"
# Đổi khoá sẽ vô hiệu hoá mọi phiên đang mở.
SESSION_SECRET=replace-with-a-strong-random-secret
# Cho phép header X-User-Id thay cookie (tiện gọi curl/Swagger khi dev).
# BẮT BUỘC đặt false ở production, nếu không client tự giả mạo danh tính được.
ALLOW_HEADER_USER_CONTEXT=false


# ---- HR upload tài liệu chính sách ----
# Để true khi dev/test để chạy luồng upload mà không gọi Modal.
# Production: đặt false và bắt buộc cấu hình BGE_M3_ENDPOINT, BGE_M3_API_KEY.
USE_FAKE_EMBEDDER=true
# Ingest chạy đồng bộ trong request nên phải chặn file quá lớn.
MAX_POLICY_UPLOAD_MB=10

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Mot dong duy nhat, phan cach bang dau phay. Xuong dong o day tung lam mat origin cuoi
# va sinh ra origin rac "http://" (AUDIT F-27f).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
DEMO_MEMBER_EMAIL=engineer.phoneshop@onboarding.dev

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Langfuse (optional; chat remains fully functional when omitted) ----
# Chat exports metadata/timings only. Raw prompts, answers and chunks are not captured.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# INTERNAL_API_URL=http://backend:8000
