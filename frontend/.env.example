# Backend mà Next proxy tới qua rewrite `/api/:path*`. Chỉ đọc phía server.
# Bỏ trống thì mặc định http://127.0.0.1:8000.
API_UPSTREAM_URL=http://127.0.0.1:8000

# Chỉ đặt khi cần gọi FastAPI trực tiếp thay vì qua proxy (ví dụ e2e trỏ cổng riêng).
# Để trống thì API đi cùng origin với trang — đó là cấu hình mong muốn, vì cookie phiên
# phải là first-party mới lưu được.
# NEXT_PUBLIC_API_URL=

# Development-only user context until SSO/OIDC is implemented.
NEXT_PUBLIC_DEMO_USER_ID=9
NEXT_PUBLIC_CONSOLE_DEMO_USER_ID=1
