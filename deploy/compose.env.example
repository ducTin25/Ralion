# Copy to /opt/p040/env/compose.env on the VPS. Do not commit the real file.
COMPOSE_PROJECT_NAME=p040-staging
PUBLIC_HOST=api-staging.34-142-10-20.sslip.io
PUBLIC_URL=https://api-staging.34-142-10-20.sslip.io
ACME_EMAIL=ops@example.com
BACKEND_ENV_FILE=/opt/p040/env/backend.env

POSTGRES_USER=p040_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=pgonboarding

# Keep only three daily dumps on the 30 GB boot disk. Download one copy weekly.
BACKUP_RETENTION_COUNT=3
