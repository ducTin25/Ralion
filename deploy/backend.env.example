# Copy to /opt/p040/env/backend.env on the VPS. Do not commit the real file.
APP_ENV=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://p040_app:replace-with-the-same-db-password@db:5432/pgonboarding
SESSION_SECRET=replace-with-at-least-32-random-bytes
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ALLOW_HEADER_USER_CONTEXT=false
CORS_ORIGINS=https://frontend.example.com

USE_FAKE_EMBEDDER=false
BGE_M3_ENDPOINT=
BGE_M3_API_KEY=
CHAT_EMBEDDING_WARMUP_ENABLED=true
CHAT_EMBEDDING_WARMUP_INTERVAL_SECONDS=240
CHAT_EMBEDDING_WARMUP_TIMEOUT_SECONDS=60

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_CLASSIFIER_TIMEOUT_SECONDS=20
DEEPSEEK_CLASSIFIER_MAX_CONCURRENCY=4

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# PM connects each project's own GitHub PAT via the app (PATCH .../github-repo) — no global
# token here for production. GITHUB_TOKEN below is a dev/test-only fallback, left unset here.
GITHUB_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
