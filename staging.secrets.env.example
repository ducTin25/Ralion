# Local-only staging integration credentials. Never commit the filled file.
# Copy this file to staging.secrets.env and fill real values before transfer.
BGE_M3_ENDPOINT=
BGE_M3_API_KEY=
DEEPSEEK_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Fernet key encrypting per-project GitHub PATs at rest (PM connects those via the app, not
# here). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_CREDENTIAL_ENCRYPTION_KEY=
